SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Scheduled jobs (P8-6): the job runner service account and the scheduler's shared secret.
JOB_RUNNER_EMAIL=
JOB_RUNNER_PASSWORD=
CRON_SECRET=
